NODE_ENV=development
HOST=127.0.0.1
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=REPLACE_WITH_LOCAL_DATABASE_NAME
DB_USER=piar_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DB_CONNECTION_LIMIT=10

CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

APP_BASE_URL=http://localhost:8080
# Transporte de correo: memory (solo desarrollo local) | resend (API HTTPS) | smtp | api
EMAIL_TRANSPORT=memory
# Remitente. Con Resend debe pertenecer a un dominio verificado en el panel de Resend.
EMAIL_FROM=piar@example.invalid
# Nombre visible opcional: produce "Nombre <EMAIL_FROM>".
EMAIL_FROM_NAME=
# Tiempo máximo de espera de los envíos por HTTPS (100-30000 ms).
EMAIL_TIMEOUT_MS=10000

# Resend (EMAIL_TRANSPORT=resend). La clave empieza por re_ y solo se define en el entorno privado.
RESEND_API_KEY=
EMAIL_DEV_OUTBOX_SECRET=
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_SECRET=

# SMTP (Gmail en producción): puerto 465 con secure=true, o 587 con secure=false (STARTTLS).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oidc/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# D4: Tenant IDs (GUID) organizacionales autorizados, separados por comas.
MICROSOFT_TENANT_IDS=
# true acepta cuentas personales de Microsoft (Outlook/Hotmail).
MICROSOFT_ALLOW_PERSONAL_ACCOUNTS=false
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/oidc/microsoft/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/api/auth/oidc/apple/callback

# Seguridad y operación
# Proxies inversos autorizados a fijar X-Forwarded-For (IPs o CIDR separados por coma,
# o "loopback"). Vacío = se usa siempre la IP del socket y se ignora X-Forwarded-For.
TRUSTED_PROXIES=
# memory (una instancia) | mysql (varias instancias; requiere migración 012)
RATE_LIMIT_STORE=memory
# Purga periódica de sesiones/tokens vencidos; 0 la desactiva.
MAINTENANCE_INTERVAL_MINUTES=60
# Retención de evento_seguridad (30-3650 días).
SECURITY_EVENT_RETENTION_DAYS=365
